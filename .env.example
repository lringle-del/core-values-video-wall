# Google service account JSON key, as a single-line string (paste the whole key file contents).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive folder (shared with the service account's email, Editor access) where videos + thumbnails are saved.
DRIVE_FOLDER_ID=

# Google Sheet (shared with the service account's email, Editor access) used as the submissions log.
SHEET_ID=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Above & Beyond <core-values@abtaba.com>"

# Comma-separated list of addresses to notify on every new submission.
TEAM_NOTIFY_EMAILS=

# Set this to the ISO date/time you actually go live. The 10-day window starts counting from here.
CAMPAIGN_START_DATE=
CAMPAIGN_DAYS=10
SUBMISSION_CAP=150
